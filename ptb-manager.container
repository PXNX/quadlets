[Container]
Image=docker.io/library/python:3.13-slim
AutoUpdate=registry
ContainerName=ptb-manager

LogDriver=journald
WorkingDir=/app

# Mount bot code
Volume=%h/projects/ptb-manager/bot:/app:Z

# Mount podman socket to control host containers
Volume=/run/user/%U/podman/podman.sock:/run/podman/podman.sock:Z

# Mount projects directory to access .env files
Volume=%h/projects:/host/projects:Z

# Mount quadlets directory
Volume=%h/.config/containers/systemd:/host/quadlets:Z

# MOUNT CHANGE: Mount the whole run directory to access the real host bus
Volume=/run/user/1001:/host/run/user/1001:ro

EnvironmentFile=%h/projects/ptb-manager/.env
Environment=CONTAINER=true
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PODMAN_SOCK=/run/podman/podman.sock

# SYSTEMD ENV CHANGE: Point internal systemctl to our credential-stripped proxy bus
Environment=XDG_RUNTIME_DIR=/run/user/1001
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1001/bus

# Set paths for containerized environment
Environment=PROJECTS_BASE=/host/projects
Environment=QUADLETS_DIR=/host/quadlets

# EXEC CHANGE: Installed `socat`, created the runtime directory, and backgrounded the proxy before running python
Exec=sh -c "apt-get update && \
    apt-get install -y git podman gh procps postgresql-client socat && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    gh auth setup-git --hostname github.com && \
    pip install --no-cache-dir -r requirements.txt && \
    mkdir -p /run/user/1001 && \
    socat UNIX-LISTEN:/run/user/1001/bus,fork UNIX-CONNECT:/host/run/user/1001/bus & \
    python -u main.py"

[Service]
Restart=always

[Install]
WantedBy=default.target