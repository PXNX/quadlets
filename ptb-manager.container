[Unit]
Description="ptb-manager"
After=local-fs.target

[Container]
Image=docker.io/library/python:3.13-slim
AutoUpdate=registry
ContainerName=ptb-manager

LogDriver=journald
WorkingDir=/app

# Mount bot code
Volume=%h/projects/ptb-manager/bot:/app:Z

# Mount podman socket to control host containers
Volume=/run/user/%U/podman/podman.sock:/run/podman/podman.sock:Z

# Mount projects directory to access .env files
Volume=%h/projects:/host/projects:Z

# Mount quadlets directory
Volume=%h/.config/containers/systemd:/host/quadlets:Z

# Mount systemd user bus to allow systemctl --user status
Volume=/run/user/%U/systemd:/run/user/0/systemd:Z
Volume=/run/user/%U/bus:/run/user/0/bus:Z

EnvironmentFile=%h/projects/ptb-manager/.env
Environment=CONTAINER=true
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PODMAN_SOCK=/run/podman/podman.sock
Environment=XDG_RUNTIME_DIR=/run/user/0

# Set paths for containerized environment
Environment=PROJECTS_BASE=/host/projects
Environment=QUADLETS_DIR=/host/quadlets

# Install git, podman, and gh CLI. `gh auth setup-git` wires git's credential
# helper to call back into `gh auth git-credential` on every git invocation -
# that's just plumbing, not a shared identity: it resolves auth dynamically
# from whatever GH_TOKEN is set in *that* subprocess's env, which the bot sets
# per Telegram user via /ghauth for each gh/git call. Deliberately NOT paired
# with a git credential cache - caching would leak one user's token into
# another user's git calls for the cache TTL.
Exec=sh -c "apt-get update && \
    apt-get install -y git podman gh procps postgresql-client && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    gh auth setup-git --hostname github.com && \
    pip install --no-cache-dir -r requirements.txt && \
    python -u main.py"

#Network=pgnet.network

[Service]
Restart=always

[Install]
WantedBy=default.target