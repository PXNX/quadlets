[Unit]
Description="ptb-mn"
After=local-fs.target

[Container]
Image=ghcr.io/militaernews/ptb-mn:latest
AutoUpdate=registry
ContainerName=ptb-mn

LogDriver=journald
WorkingDir=/app
Volume=%h/projects/ptb-mn/bot:/app:Z
Volume=%h/projects/ptb-mn/secrets:/app/secrets:Z

EnvironmentFile=%h/projects/ptb-mn/.env
Environment=CONTAINER=true
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

node /opt/bgutil/server/build/main.js & NODE_PID=$!
until curl -sf http://127.0.0.1:4416/ >/dev/null 2>&1; do
  kill -0 $NODE_PID 2>/dev/null || { echo "bgutil server died"; exit 1; }
  sleep 1
done

Network=pgnet.network

[Service]
Restart=always

[Install]
WantedBy=default.target