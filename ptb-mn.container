[Unit]
Description="ptb-mn"
After=local-fs.target

[Container]
Image=ghcr.io/militaernews/ptb-mn:latest
AutoUpdate=registry
ContainerName=ptb-mn

LogDriver=journald
WorkingDir=/app
Volume=%h/projects/ptb-mn/bot:/app:Z
Volume=%h/projects/ptb-mn/secrets:/app/secrets:Z

EnvironmentFile=%h/projects/ptb-mn/.env
Environment=CONTAINER=true
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

Exec=sh -c "\
  echo 'Step 1: Installing Python dependencies...' && \
  pip install --no-cache-dir -r requirements.txt && \
  echo 'Step 1: Done.' && \
  echo 'Step 2: Starting bgutil POT server...' && \
  node /opt/bgutil/server/build/main.js & NODE_PID=$! && \
  echo 'Step 2: bgutil PID is '$NODE_PID && \
  echo 'Step 3: Waiting for bgutil to be ready...' && \
  until curl -sf http://[::1]:4416/ >/dev/null 2>&1; do \
    kill -0 $NODE_PID 2>/dev/null || { echo 'Step 3: bgutil server died, aborting.'; exit 1; }; \
    sleep 1; \
  done && \
  echo 'Step 3: bgutil is ready.' && \
  echo 'Step 4: Starting Python bot...' && \
  python -u main.py"

Network=pgnet.network

[Service]
Restart=always

[Install]
WantedBy=default.target