[Unit]
Description="ptb-mn"
After=local-fs.target

[Container]
Image=ghcr.io/militaernews/ptb-mn:latest
AutoUpdate=registry
ContainerName=ptb-mn

LogDriver=journald
WorkingDir=/app
Volume=%h/projects/ptb-mn/bot:/app:Z
Volume=%h/projects/ptb-mn/secrets:/app/secrets:Z

EnvironmentFile=%h/projects/ptb-mn/.env
Environment=CONTAINER=true
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

Exec=sh -c "pip install --no-cache-dir -r requirements.txt && node /opt/bgutil/server/build/server.js & sleep 3 && python -u main.py"

Network=pgnet.network

[Service]
Restart=always

[Install]
WantedBy=default.target