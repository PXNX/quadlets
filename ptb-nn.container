[Unit]
Description="ptb-nn"
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=ptb-nn
Image=ghcr.io/militaernews/ptb-nn:latest
AutoUpdate=registry

EnvironmentFile=%h/projects/ptb-nn/.env
Environment=PYTHONPATH=/
WorkingDir=/bot
Exec=python -m main

Network=pgnet.network

[Service]
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
