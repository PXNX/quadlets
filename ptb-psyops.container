[Unit]
Description="ptb-psyops (Auth & Premium Purchases)"
After=local-fs.target

[Container]
Image=ghcr.io/pxnx/ptb-psyops:latest
AutoUpdate=registry
ContainerName=ptb-psyops
LogDriver=journald
WorkingDir=/app
Volume=%h/projects/ptb-psyops/bot:/app:Z
EnvironmentFile=%h/projects/ptb-psyops/.env
Environment=CONTAINER=true
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

Exec=sh -c "pip install --no-cache-dir -r requirements.txt && python -u main.py"

[Service]
Restart=always

[Install]
WantedBy=default.target
