[Unit]
Description="ptb-suggest"
After=local-fs.target

[Container]
Image=ghcr.io/militaernews/ptb-suggest:latest
AutoUpdate=registry
ContainerName=ptb-suggest

LogDriver=journald
WorkingDir=/app
Volume=%h/projects/ptb-suggest/bot:/app:Z

EnvironmentFile=%h/projects/ptb-suggest/.env
Environment=CONTAINER=true
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

Exec=sh -c "pip install --no-cache-dir -r requirements.txt && python -u main.py"

Network=pgnet.network

[Service]
Restart=always

[Install]
WantedBy=default.target
