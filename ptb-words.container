[Unit]
Description="ptb-words"
After=local-fs.target

[Container]
# No custom image: the bot is plain python-telegram-bot, installed from bot/requirements.txt at start.
Image=docker.io/library/python:3.13-slim
AutoUpdate=registry
ContainerName=ptb-words

LogDriver=journald
WorkingDir=/app
# bot/data/donations.db lives in this bind mount, so the ledger survives restarts and redeploys.
Volume=%h/projects/ptb-words/bot:/app:Z

EnvironmentFile=%h/projects/ptb-words/.env
Environment=CONTAINER=true
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

Exec=sh -c "pip install --no-cache-dir -r requirements.txt && python -u main.py"

[Service]
Restart=always

[Install]
WantedBy=default.target
