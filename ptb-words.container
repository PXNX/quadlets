[Unit]
Description="ptb-words"
After=local-fs.target words-db.service
Wants=words-db.service

[Container]
# No custom image: the bot is plain python-telegram-bot, installed from bot/requirements.txt at start.
Image=docker.io/library/python:3.13-slim
AutoUpdate=registry
ContainerName=ptb-words

LogDriver=journald
WorkingDir=/app
# The donation ledger is in words-db (DATABASE_URL in .env)
Volume=%h/projects/words-sv/bot/bot:/app:Z

EnvironmentFile=%h/projects/words-sv/bot/.env
Environment=CONTAINER=true
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

Exec=sh -c "pip install --no-cache-dir -r requirements.txt && python -u main.py"

Network=pgnet.network

[Service]
Restart=always

[Install]
WantedBy=default.target
