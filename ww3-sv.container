[Unit]
Description="ww3-sv"
After=local-fs.target ww3-db.service
Wants=ww3-db.service

[Container]
# The Telegram bot of World War 3 (@game_ww3_bot) lives in bot/ of the game's repository. No custom
# image: python-telegram-bot and the rest are installed from bot/requirements.txt at start.
Image=docker.io/library/python:3.13-slim
AutoUpdate=registry
ContainerName=ww3-sv

LogDriver=journald
WorkingDir=/app
# bot/config.local.json (operator data) lives in this bind mount; the ledger is in ww3-db
Volume=%h/projects/ww3-sv/bot:/app:Z

# The Mini App endpoints; only Tailscale Funnel (:10000 -> 127.0.0.1:3790) exposes them publicly
PublishPort=127.0.0.1:3790:3790

# TELEGRAM and DATABASE_URL (postgresql://ww3:...@ww3-db:5432/ww3)
EnvironmentFile=%h/projects/ww3-sv/.env
Environment=CONTAINER=true
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

Exec=sh -c "pip install -q --root-user-action=ignore --disable-pip-version-check -r requirements.txt && python -u -m ww3bot"

Network=pgnet.network

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
